{
  "name": "payment-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "payment-platform",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@payments/api",
      "version": "0.1.0"
    },
    "node_modules/@payments/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@payments/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "packages/domain": {
      "name": "@payments/domain",
      "version": "0.1.0"
    }
  }
}
